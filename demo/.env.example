# Optional: the demo runs without a .env file. Copy this to demo/.env and uncomment what you
# want to change. Everything here is a default.

# --- Where to open it ---
# Port of the site on this machine.
# FRONTEND_PORT=3000
# Port of Mailpit, where every email the forum sends shows up.
# MAILPIT_PORT=8025
# The address people will type in the browser, no trailing slash. It is what links in emails
# point to, so if you change FRONTEND_PORT, or open the demo from another machine, change this too.
# SITE_URL=http://localhost:3000

# --- Accounts created on the first run (the admin can moderate, the user is a regular member) ---
# Both are already email-verified. Passwords need at least 8 characters. These are only read on
# the first run: once the database has users, changing them does nothing (run
# `docker compose down -v` to start from scratch).
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@notathome.local
# SEED_ADMIN_PASSWORD=admin-password
# SEED_USER_USERNAME=rider
# SEED_USER_EMAIL=rider@notathome.local
# SEED_USER_PASSWORD=rider-password

# --- Database ---
# Also only effective on the first run (PostgreSQL stores it when it creates the database).
# DB_PASSWORD=notathome
