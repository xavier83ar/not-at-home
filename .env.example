# Copy to .env and adjust. Dev needs none of these: the `dev` profile uses
# the defaults from compose.yaml. They are required when running the
# production images (SPRING_PROFILES_ACTIVE=prod).

# --- Backend ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/notathome
DB_USER=notathome
DB_PASSWORD=change-me
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
# Sender of every email, and the public address of the site (used for links in emails).
MAIL_FROM=noreply@example.com
FRONTEND_URL=https://notathome.example
# Local-disk directory for uploaded files (avatars, category covers, post images). Must be a
# persisted volume: anything written here is lost if it isn't.
APP_UPLOADS_DIR=/var/lib/notathome/uploads

# --- Frontend ---
# Where the frontend server finds the backend (used for /api proxying and SSR calls).
NUXT_BACKEND_URL=http://localhost:8080

# --- Client addresses and rate limits (see README, "Rate limits") ---
# Set to true only if a reverse proxy in front of the frontend sets X-Forwarded-For itself and
# nothing can reach the frontend directly. Otherwise every visitor looks like the proxy.
NUXT_TRUST_FORWARDED_FOR=false
# Regular expression for the addresses the backend trusts to tell it who the visitor is. The
# default (loopback and private networks) fits a backend that only the frontend can reach.
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
# Local testing only: switches the rate limits off.
# APP_RATE_LIMIT_ENABLED=false
